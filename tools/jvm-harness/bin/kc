#!/bin/bash
# usage: kc <outdir> <classpath> [kotlinc args...] sources...
. "$(dirname "$0")/env.sh"
CCP="$K/kotlin-jupyter-kernel-0.19.0-944-all.jar:$K/kotlin-stdlib-2.3.10-RC.jar:$K/kotlin-reflect-2.3.10-RC.jar:$K/kotlin-script-runtime-2.4.0-dev-6891.jar:$K/annotations-13.0.jar"
OUT=$1; shift; CP=$1; shift
exec "$JAVA" -Xmx2600m -Xss4m --enable-native-access=ALL-UNNAMED -XX:+UseSerialGC -cp "$CCP" \
  org.jetbrains.kotlin.cli.jvm.K2JVMCompiler -no-stdlib -no-reflect -jvm-target 17 \
  -Xsuppress-version-warnings -nowarn -Xplugin="$H/serplugin.jar" -cp "$CP" -d "$OUT" "$@"
