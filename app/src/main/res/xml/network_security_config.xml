<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The app dials exactly one host: the user-configured PC agent, normally
         over cleartext ws:// on the LAN (DHCP addresses) or Tailscale. NSC
         <domain> entries are DNS names / exact literals and cannot express IP
         ranges, so per-host scoping is impossible for LAN addresses and
         cleartext is allowed at the base level. wss:// profiles still
         negotiate TLS against the system trust anchors. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
