<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_prefs.xml"/>
        <exclude domain="file" path="datastore/anki_review_commit_ledger.preferences_pb"/>
        <exclude domain="file" path="datastore/anki_review_commit_ledger.preferences_pb.tmp"/>
