<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <exclude domain="sharedpref" path="secure_prefs.xml"/>
    <!-- Rating-commit truth is not backup material, even if allowBackup is later re-enabled. -->
    <exclude domain="file" path="datastore/anki_review_commit_ledger.preferences_pb"/>
    <exclude domain="file" path="datastore/anki_review_commit_ledger.preferences_pb.tmp"/>
    <!-- GATE 13: the reviewer-action ledger must never be restored onto another device. -->
    <exclude domain="file" path="datastore/anki_reviewer_action_ledger.preferences_pb"/>
    <exclude domain="file" path="datastore/anki_reviewer_action_ledger.preferences_pb.tmp"/>
</full-backup-content>
